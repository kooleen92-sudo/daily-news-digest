# ==============================================================================
# 每日财经与中国宏观深度简报配置说明
# 目标外媒：彭博社、路透社、华尔街日报、金融时报、联合早报、日经中文网、经济学人
# ==============================================================================

# 1. 定时任务与调度配置
DIGEST_TIME=08:00
DIGEST_TIMEZONE=Asia/Shanghai
LOOKBACK_HOURS=24
MAX_ITEMS_PER_SOURCE=5
FETCH_TIMEOUT=15.0
DEDUPE_SIMILARITY=0.85

# 2. 邮件收发配置 (支持单收件人或多个收件人以逗号分隔)
# MAIL_TO=investor1@qq.com, investor2@163.com
MAIL_TO=

# 发件人邮箱与 SMTP 服务器配置：
# 【方案A：QQ邮箱】
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USER=your_qq@qq.com
# SMTP_PASSWORD=your_qq_authorization_code  # 注意：在QQ邮箱网页版「设置 - 账户」中生成“授权码”，非QQ密码
# MAIL_FROM=your_qq@qq.com

# 【方案B：163网易邮箱】
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USER=your_name@163.com
# SMTP_PASSWORD=your_163_authorization_code # 网页版开启POP3/SMTP获取的授权密码
# MAIL_FROM=your_name@163.com

# 【方案C：Gmail】
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_SSL=false
# SMTP_USE_TLS=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_app_password     # Google 账号「安全性 - 应用专用密码」
# MAIL_FROM=your_email@gmail.com

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# 3. 多渠道推送配置（可选，邮件遇到异常时可自动协同备用推送）
# 企业微信群机器人 Webhook 地址
WECOM_WEBHOOK_URL=

# 飞书群自定义机器人 Webhook 地址
FEISHU_WEBHOOK_URL=

# 钉钉群自定义机器人 Webhook 地址
DINGTALK_WEBHOOK_URL=

# Server酱 SendKey (微信推送)
SERVERCHAN_KEY=

# Telegram Bot 通知
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 4. AI 深度分析引擎配置（支持多模型智能容灾：Gemini 优先 -> DeepSeek 自动接管 -> OpenAI 兜底）
# 若全部留空，则使用结构化新闻列表兜底排版，不会中断推送。

# 【引擎 A：Google Gemini 旗舰引擎（Tier 1，现役 3.x 系列）】
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-3.8-flash        # 极速高吞吐：gemini-3.8-flash，高阶推理旗舰：gemini-3.1-pro
# 注意：gemini-3.5-flash 已被 Google 官方弃用（请求会自动路由至 gemini-3.6-flash），请勿再作为 GEMINI_MODEL 的默认值。
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 【引擎 B：DeepSeek 引擎（Tier 2 自动容灾接管，现役旗舰 V4 系列）】
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 【引擎 C：官方 OpenAI / 兼容第三方（Tier 3）】
# OPENAI_API_KEY=sk-xxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 5. 系统维护与优化
LLM_TIMEOUT=90.0
# 单次报告生成的最大输出 token 数：常规模型 / 长报告与高推理模型（如 pro、reasoner）
LLM_MAX_TOKENS=8192
LLM_MAX_TOKENS_LARGE=16384
OUTPUT_RETENTION_DAYS=7
COMPRESS_IMAGE=true
# 抓取阶段自动将 Google News 跳转链解析为发布方真实原文链接（默认开启，如需关闭设为 false）
RESOLVE_GOOGLE_NEWS=true
