# ==============================================================================
# 每日财经与中国宏观简报配置说明
# 目标外媒：彭博社、路透社、华尔街日报、金融时报、联合早报
# ==============================================================================

# 1. 定时任务与调度配置
DIGEST_TIME=08:00
DIGEST_TIMEZONE=Asia/Shanghai
LOOKBACK_HOURS=24
MAX_ITEMS_PER_SOURCE=5
FETCH_TIMEOUT=15.0
DEDUPE_SIMILARITY=0.85

# 2. 邮件收发配置 (以国内常用邮箱为例)
# 收件人邮箱（填你自己的邮箱）
MAIL_TO=your_email@qq.com

# 发件人邮箱与 SMTP 服务器配置：
# 【方案A：QQ邮箱】
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USER=your_qq@qq.com
# SMTP_PASSWORD=your_qq_authorization_code  # 注意：在QQ邮箱网页版「设置 - 账户」中生成“授权码”，非QQ密码
# MAIL_FROM=your_qq@qq.com

# 【方案B：163网易邮箱】
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USER=your_name@163.com
# SMTP_PASSWORD=your_163_authorization_code # 网页版开启POP3/SMTP获取的授权密码
# MAIL_FROM=your_name@163.com

# 【方案C：Gmail】
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_SSL=false
# SMTP_USE_TLS=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_gmail_app_password     # Google 账号「安全性 - 应用专用密码」
# MAIL_FROM=your_email@gmail.com

# 默认待填写模板：
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# 3. AI 深度分析引擎配置（支持多模型智能容灾：Gemini 优先 -> DeepSeek 自动接管 -> OpenAI 兜底）
# 若全部留空，则使用结构化新闻列表兜底排版，不会中断邮件推送。

# 【引擎 A：Google Gemini 旗舰引擎（Tier 1）】
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 【引擎 B：DeepSeek 引擎（Tier 2 自动容灾接管）】
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 【引擎 C：官方 OpenAI / 兼容第三方（Tier 3）】
# OPENAI_API_KEY=sk-xxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 4. 系统维护与优化
LLM_TIMEOUT=90.0
OUTPUT_RETENTION_DAYS=7
COMPRESS_IMAGE=true

